rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidTask(data, userId) {
      return data.userId is string && data.userId == userId && data.userId == request.auth.uid && data.userId.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 2000)) &&
        data.priority is string && data.priority in ['HIGH', 'MEDIUM', 'LOW'] &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
        data.sourceType is string && data.sourceType in ['MANUAL', 'FILE', 'PHOTO'] &&
        (!('sourceName' in data) || data.sourceName == null || (data.sourceName is string && data.sourceName.size() <= 200)) &&
        data.completed is bool &&
        data.dueAtMillis is int && data.dueAtMillis >= 0 && data.dueAtMillis <= 4102444800000 &&
        data.reminderMinutesBefore is int && data.reminderMinutesBefore >= 0 && data.reminderMinutesBefore <= 10080 &&
        data.reminderEnabled is bool &&
        data.telegramNotified is bool &&
        (!('smartReminderText' in data) || data.smartReminderText == null || (data.smartReminderText is string && data.smartReminderText.size() <= 500)) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAiScan(data, userId) {
      return data.userId is string && data.userId == userId && data.userId == request.auth.uid && data.userId.size() <= 128 &&
        data.sourceType is string && data.sourceType in ['FILE', 'PHOTO'] &&
        data.sourceName is string && data.sourceName.size() >= 1 && data.sourceName.size() <= 200 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 1000 &&
        data.extractedCount is int && data.extractedCount >= 0 && data.extractedCount <= 50 &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // --- User-Scoped Collections ---
    match /users/{userId}/tasks/{taskId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(taskId);
      allow delete: if isOwner(userId) && isValidId(taskId);

      allow create: if isOwner(userId) &&
        isValidId(taskId) &&
        incoming().keys().hasAll([
          'userId', 'title', 'priority', 'category', 'sourceType',
          'completed', 'dueAtMillis', 'reminderMinutesBefore',
          'reminderEnabled', 'telegramNotified', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'title', 'description', 'priority', 'category',
          'sourceType', 'sourceName', 'completed', 'dueAtMillis',
          'reminderMinutesBefore', 'reminderEnabled', 'telegramNotified',
          'smartReminderText', 'createdAt', 'updatedAt'
        ]) &&
        isValidTask(incoming(), userId);

      allow update: if isOwner(userId) &&
        isValidId(taskId) &&
        isValidTask(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().sourceType == existing().sourceType &&
        incoming().createdAt == existing().createdAt &&
        (
          // Action 1: Toggle completion state
          incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt']) ||
          // Action 2: Mark Telegram reminder sent/reset
          incoming().diff(existing()).affectedKeys().hasOnly(['telegramNotified', 'updatedAt']) ||
          // Action 3: Edit task fields and reminder configuration
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'priority', 'category', 'completed',
            'dueAtMillis', 'reminderMinutesBefore', 'reminderEnabled',
            'telegramNotified', 'smartReminderText', 'updatedAt'
          ])
        );
    }

    match /users/{userId}/ai_scans/{scanId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(scanId);
      allow delete: if isOwner(userId) && isValidId(scanId);

      allow create: if isOwner(userId) &&
        isValidId(scanId) &&
        incoming().keys().hasAll([
          'userId', 'sourceType', 'sourceName', 'summary', 'extractedCount', 'createdAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'sourceType', 'sourceName', 'summary', 'extractedCount', 'createdAt'
        ]) &&
        isValidAiScan(incoming(), userId);

      // Scan history logs are immutable once created
      allow update: if false;
    }
  }
}
